# Admin client. NEXT_PUBLIC_* values are bundled into the browser code at build time.
# Copy to .env.local for native `npm run dev`.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Dev-only shared key sent as X-Admin-Key. Must match ADMIN_API_KEY in services/api/.env.
# It ends up in the JavaScript bundle, so anyone who can load the app can read it: replace it with real
# authentication (e.g. NextAuth / Clerk) before any public deployment.
NEXT_PUBLIC_ADMIN_API_KEY=dev-admin-key
