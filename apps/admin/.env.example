# ELEVARIQ admin app. Copy to .env.local for native `npm run dev`.
#
# Everything here is read on the SERVER. Nothing is bundled into the browser: the browser only talks to this app's
# own /api/proxy, which checks the sign-in session and adds the admin key to the API call.

# Where this app is served (NextAuth needs it), and a long random secret that signs the session cookie.
#   openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=dev-only-change-me-dev-only-change-me

# Who may sign in: comma-separated `email=password hash`. Make a hash with
#   npm run hash-password -w @tryon/admin -- 'the password'
# This dev user is admin@example.com / dev-admin-password. Replace it before any shared deployment.
ADMIN_USERS=admin@example.com=scrypt:a0825745c2458e92da2f46c4df5e2fa4:b857eb642e5427b2ab38b432db3379f023939a22069d9618aff64f40e73cb297830f40175fea0de4f04c9eff0a5b51fe58e9cfee682983c1402ce8b7bccea870

# The API (server to server) and the key the proxy sends as X-Admin-Key. Must match ADMIN_API_KEY on the API.
API_URL=http://localhost:8000
ADMIN_API_KEY=dev-admin-key

# --- Error reporting (off while empty) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
#SENTRY_AUTH_TOKEN=
#SENTRY_ORG=
#SENTRY_PROJECT=
