# Admin client. Copy to .env.local for native `npm run dev`.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/tryon-media

# Dev-only shared key sent as X-Admin-Key. Must match ADMIN_API_KEY in services/api/.env.
# Replace with real auth (e.g. NextAuth / Clerk) before any public deployment.
NEXT_PUBLIC_ADMIN_API_KEY=dev-admin-key
