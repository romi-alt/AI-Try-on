# Kiosk client (browser-exposed vars only; NEXT_PUBLIC_* are bundled into the client at build time)
# Copy to .env.local for native `npm run dev`.

# The API. Images come back as full URLs, so no separate media URL is needed.
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket base for live progress. Defaults to the API host (http -> ws, https -> wss).
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Photo sent to the API: portrait 3:4, at least 768px tall. The webcam frame is cropped to fit.
NEXT_PUBLIC_CAPTURE_WIDTH=864
NEXT_PUBLIC_CAPTURE_HEIGHT=1152
# Seconds of 3-2-1 before the photo is taken
NEXT_PUBLIC_COUNTDOWN_SECONDS=3
