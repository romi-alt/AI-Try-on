# Kiosk client (browser-exposed vars only; NEXT_PUBLIC_* are bundled into the client)
# Copy to .env.local for native `npm run dev`.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/tryon-media

# Identifies this physical mirror in session records
NEXT_PUBLIC_KIOSK_ID=dev-laptop

# Webcam capture settings
NEXT_PUBLIC_CAPTURE_WIDTH=720
NEXT_PUBLIC_CAPTURE_HEIGHT=960
