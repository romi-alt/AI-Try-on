# Kiosk client (browser-exposed vars only; NEXT_PUBLIC_* are bundled into the client at build time)
# Copy to .env.local for native `npm run dev`.

# The API. Images come back as full URLs, so no separate media URL is needed.
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket base for live progress. Defaults to the API host (http -> ws, https -> wss).
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Photo sent to the API: portrait 3:4, at least 768px tall. The webcam frame is cropped to fit.
NEXT_PUBLIC_CAPTURE_WIDTH=864
NEXT_PUBLIC_CAPTURE_HEIGHT=1152
# Seconds of 3-2-1 before the photo is taken
NEXT_PUBLIC_COUNTDOWN_SECONDS=3

# Idle timeout: after this many seconds without input an "Are you still there?" screen appears, and if nobody
# answers within the grace period (45 + 15 = the 60 seconds before the attract screen) the session ends and the
# kiosk returns to the attract screen. It is paused while a try-on is being made. Set the first to 0 to turn it off.
NEXT_PUBLIC_IDLE_WARN_SECONDS=45
NEXT_PUBLIC_IDLE_GRACE_SECONDS=15

# Address phones use to open the mobile page the QR code points to (/m/CODE). It must be reachable from a phone:
# on a shop network that is the kiosk's LAN address or public domain, not localhost. Empty: this kiosk's own address.
# NEXT_PUBLIC_PUBLIC_URL=https://mirror.example.com

# Pose guidance (MediaPipe) runs on the CPU by default, which is fast enough and has no GPU surprises.
# NEXT_PUBLIC_POSE_DELEGATE=GPU

# Seconds of "Almost there..." before the screen offers Try again (the job keeps running meanwhile).
NEXT_PUBLIC_TRYON_SLOW_SECONDS=60
