# Copy to ~/.config/elevariq-kiosk.env on the kiosk machine.

# Where the mirror is served (the Vercel kiosk project). Must be https:// (browsers only allow the camera on https).
KIOSK_URL=https://mirror.example.com/

# Portrait screens: the output name from `xrandr`, and left or right (the direction that makes the top of the
# picture point at the top of the screen). Leave empty if the screen is already portrait.
#KIOSK_OUTPUT=HDMI-1
#KIOSK_ROTATE=left

# Only if Chrome is somewhere unusual, or to keep the browser profile elsewhere.
#CHROME_BIN=/usr/bin/google-chrome-stable
#KIOSK_PROFILE=/home/mirror/.config/elevariq-chrome
