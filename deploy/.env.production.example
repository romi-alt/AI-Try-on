# ELEVARIQ Virtual Try on Mirror: production settings for the VPS stack (deploy/docker-compose.prod.yml).
#   cp .env.production.example .env.production   and fill in every CHANGE_ME.
# This file is git-ignored once copied. NEVER commit real values. `python3 preflight.py` checks it.
#
# Generate secrets with:  openssl rand -hex 24

# ---- Domain and HTTPS ----------------------------------------------------------------------------------------
# The API's public address (its DNS A/AAAA record must point at this server). Caddy gets the certificate itself.
API_DOMAIN=api.CHANGE_ME.example
ACME_EMAIL=CHANGE_ME@example.com

# ---- Postgres (managed; needs the pgvector extension) ------------------------------------------------------
# Use the provider's connection string with sslmode=require, in SQLAlchemy form (postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://USER:CHANGE_ME@HOST:5432/DBNAME?sslmode=require

# ---- Redis (in this stack; not exposed outside the Docker network) --------------------------------------------
# Letters and digits only (it is placed inside a URL). The compose file builds REDIS_URL from it.
REDIS_PASSWORD=CHANGE_ME

# ---- Who may call the API from a browser -------------------------------------------------------------------
# Comma-separated, exact origins (scheme + host, no path, no trailing slash): the kiosk and admin on Vercel.
API_CORS_ORIGINS=https://mirror.CHANGE_ME.example,https://admin.CHANGE_ME.example

# ---- Secrets shared with the apps ---------------------------------------------------------------------------
# ADMIN_API_KEY must equal ADMIN_API_KEY in the Vercel admin project. STAFF_API_KEY is typed on the staff page.
ADMIN_API_KEY=CHANGE_ME
STAFF_API_KEY=CHANGE_ME

# ---- Object storage (Cloudflare R2 or any S3-compatible bucket) --------------------------------------------
S3_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
S3_PRESIGN_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# The bucket's public address, where product images and looks are served from (an R2 custom domain)
S3_PUBLIC_BASE_URL=https://media.CHANGE_ME.example

# ---- Privacy: how long a shopper's photo and look may exist --------------------------------------------------
# The kiosk's notice says "within one hour". Keep both at or below 3600, and keep the kiosk's
# NEXT_PUBLIC_PHOTO_RETENTION_MINUTES (Vercel) equal to this.
CAPTURE_TTL_SECONDS=3600
RESULT_TTL_SECONDS=3600
CAPTURE_CLEANUP_ENABLED=true

# ---- Try-on provider -----------------------------------------------------------------------------------------
# mock (offline demo) | fashn | catvton. The real ones need their keys below.
TRYON_PROVIDER=fashn
FASHN_API_KEY=CHANGE_ME
# For TRYON_PROVIDER=catvton:
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=

# ---- Hardening -------------------------------------------------------------------------------------------------
API_DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true
# Raise if several mirrors share one shop address (1.0 = defaults in app/core/ratelimit.py)
RATE_LIMIT_SCALE=1.0

# ---- Monitoring (optional; each is off while empty) ------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---- Notifications for "Request Outfit" ------------------------------------------------------------------------
NOTIFIER=console
# NOTIFIER=whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO=
# WHATSAPP_TEMPLATE_NAME=

# ---- Payments (the mobile page) ---------------------------------------------------------------------------------
# Only the stub exists: it approves every payment. Do not take real money with it.
PAYMENT_PROVIDER=stub

LOG_LEVEL=INFO
RELEASE=latest
