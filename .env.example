# ------------------------------------------------------------------
# Root environment for docker-compose (infra/docker-compose.yml).
# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- Postgres (pgvector) ---
POSTGRES_USER=tryon
POSTGRES_PASSWORD=tryon_dev_password
POSTGRES_DB=tryon
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (local stand-in for Cloudflare R2) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=tryon-media

# --- Service ports (host side) ---
API_PORT=8000
KIOSK_PORT=3000
ADMIN_PORT=3001

# --- Shared app config ---
# Public URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL the browser uses to load images from the bucket
S3_PUBLIC_BASE_URL=http://localhost:9000/tryon-media

# --- Try-on model provider (worker) ---
# "stub" composites the garment onto the frame locally with no external calls.
# Swap for a real provider (e.g. "replicate") and set its key in services/worker/.env.
TRYON_PROVIDER=stub
