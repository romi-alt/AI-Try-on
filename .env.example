# ------------------------------------------------------------------
# Root environment for docker-compose (infra/docker-compose.yml).
# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- Postgres (pgvector) ---
POSTGRES_USER=tryon
POSTGRES_PASSWORD=tryon_dev_password
POSTGRES_DB=tryon
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (local stand-in for Cloudflare R2) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=tryon-media

# --- Service ports (host side) ---
API_PORT=8000
KIOSK_PORT=3000
ADMIN_PORT=3001

# --- Shared app config ---
# Public URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL the browser uses to load images from the bucket
S3_PUBLIC_BASE_URL=http://localhost:9000/tryon-media

# --- Try-on provider (worker) ---
# mock  : offline; waits MOCK_DURATION_SECONDS, then overlays the garments on the photo.
# fashn : hosted FASHN API. Set FASHN_API_KEY below. Supports tops, bottoms and dresses only.
# catvton : CatVTON on your own RunPod serverless endpoint (services/catvton). Set RUNPOD_API_KEY and
#           RUNPOD_ENDPOINT_ID below. Tops, bottoms and dresses only.
TRYON_PROVIDER=mock
MOCK_DURATION_SECONDS=8
# Set to true to force every job to fail (for building the kiosk's error screen).
MOCK_FAIL=false
# Never commit a real key.
FASHN_API_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# RQ queue shared by the API and worker
TRYON_QUEUE_NAME=tryon

# --- Secrets for the staff page and the admin app (dev defaults; replace before any shared deployment) ---
ADMIN_API_KEY=dev-admin-key
STAFF_API_KEY=dev-staff-key
# Admin sign-in: a long random secret, and `email=password hash` pairs (see apps/admin/.env.example).
# The default user is admin@example.com / dev-admin-password.
NEXTAUTH_SECRET=dev-only-change-me-dev-only-change-me
ADMIN_USERS=admin@example.com=scrypt:a0825745c2458e92da2f46c4df5e2fa4:b857eb642e5427b2ab38b432db3379f023939a22069d9618aff64f40e73cb297830f40175fea0de4f04c9eff0a5b51fe58e9cfee682983c1402ce8b7bccea870
# Address phones use to open the mobile page the kiosk's QR code points to
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
