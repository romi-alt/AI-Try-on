# Production image for the try-on worker: installed (not editable), no dev tools, unprivileged user.
#   docker build -f services/worker/Dockerfile.prod -t elevariq/worker:<tag> services/worker
# The `assets` worker (embeddings, background removal) needs the heavy ML stack: see Dockerfile.assets.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /src
COPY pyproject.toml ./
COPY worker ./worker
RUN pip install . && rm -rf /src

RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin app
WORKDIR /app
USER app

# Healthy = Postgres and Redis answer and this worker's queue has a fresh heartbeat (see worker/healthcheck.py).
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["python", "-m", "worker.healthcheck"]

CMD ["python", "-m", "worker.main"]
