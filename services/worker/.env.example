# Worker. Copy to .env for running natively. Injected by compose otherwise.

DATABASE_URL=postgresql+psycopg://tryon:tryon_dev_password@localhost:5432/tryon
REDIS_URL=redis://localhost:6379/0
TRYON_QUEUE_KEY=tryon:jobs

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tryon-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_password

# Try-on provider: "stub" (local compositing, no network) or "replicate".
TRYON_PROVIDER=stub

# Only needed when TRYON_PROVIDER=replicate. Never commit a real token.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=owner/model:version

# How long a single job may run before it is marked failed
JOB_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
