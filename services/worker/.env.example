# Worker. Copy to .env for running natively. Injected by docker-compose otherwise.

DATABASE_URL=postgresql+psycopg://tryon:tryon_dev_password@localhost:5432/tryon
REDIS_URL=redis://localhost:6379/0
TRYON_QUEUE_NAME=tryon
JOB_TIMEOUT_SECONDS=300

# S3-compatible storage (MinIO locally, Cloudflare R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
# Host-visible endpoint used in the signed result URL the browser opens
S3_PRESIGN_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tryon-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_password
S3_PUBLIC_BASE_URL=http://localhost:9000/tryon-media
RESULT_URL_EXPIRES_SECONDS=3600

# --- Provider: mock | fashn ---
TRYON_PROVIDER=mock

# mock
MOCK_DURATION_SECONDS=8
MOCK_STEPS=8
MOCK_FAIL=false

# fashn (only used when TRYON_PROVIDER=fashn). Never commit a real key.
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1
FASHN_MODEL_NAME=tryon-v1.6
FASHN_MODE=balanced
FASHN_POLL_INTERVAL_SECONDS=3
FASHN_TIMEOUT_SECONDS=180

LOG_LEVEL=INFO
