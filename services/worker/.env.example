# Worker. Copy to .env for running natively. Injected by docker-compose otherwise.

DATABASE_URL=postgresql+psycopg://tryon:tryon_dev_password@localhost:5432/tryon
REDIS_URL=redis://localhost:6379/0
TRYON_QUEUE_NAME=tryon
JOB_TIMEOUT_SECONDS=300
# Keep each job's latest state (Redis hash job:{id}) this long after its last update
JOB_STATE_TTL_SECONDS=86400

# S3-compatible storage (MinIO locally, Cloudflare R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
# Host-visible endpoint used in the signed result URL the browser opens
S3_PRESIGN_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tryon-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_password
S3_PUBLIC_BASE_URL=http://localhost:9000/tryon-media
RESULT_URL_EXPIRES_SECONDS=3600

# --- Provider: mock | fashn | catvton ---
TRYON_PROVIDER=mock

# mock
MOCK_DURATION_SECONDS=8
MOCK_STEPS=8
MOCK_FAIL=false

# fashn (only used when TRYON_PROVIDER=fashn). Never commit a real key.
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1
FASHN_MODEL_NAME=tryon-v1.6
FASHN_MODE=balanced
FASHN_POLL_INTERVAL_SECONDS=3
FASHN_TIMEOUT_SECONDS=180

# catvton (only used when TRYON_PROVIDER=catvton): CatVTON on a RunPod serverless endpoint, see services/catvton.
# The key is a secret: set it in the environment, never in a committed file.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_BASE_URL=https://api.runpod.ai/v2
CATVTON_POLL_INTERVAL_SECONDS=2
# Must cover a cold start (the endpoint scales to zero) plus the render
CATVTON_TIMEOUT_SECONDS=420
CATVTON_STEPS=30
CATVTON_GUIDANCE_SCALE=2.5
CATVTON_SEED=555

LOG_LEVEL=INFO

# --- asset jobs (embeddings, background removal): own queue and worker, `WORKER_QUEUES=assets` ---
ASSETS_QUEUE_NAME=assets
# Which queues this process works: tryon (default) or assets
WORKER_QUEUES=tryon
FASHION_CLIP_MODEL=patrickjohncyh/fashion-clip
REMBG_MODEL=isnet-general-use
# Path to a SAM 2.1 checkpoint (python -m worker.download_models); empty skips SAM 2 and uses rembg's outline
SAM2_CHECKPOINT=
