# Worker for the `assets` queue: FashionCLIP embeddings, background removal (rembg) and SAM 2 masks.
# CPU build by default. For a GPU host, build with TORCH_INDEX=https://download.pytorch.org/whl/cu121 (or similar).
#
#   docker build -f Dockerfile.assets -t tryon-assets-worker .
FROM python:3.12-slim

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WORKER_QUEUES=assets \
    MODELS_DIR=/models \
    HF_HOME=/models/hf \
    U2NET_HOME=/models/u2net \
    SAM2_CHECKPOINT=/models/sam2.1_hiera_tiny.pt

WORKDIR /app

# libgl/glib: runtime libraries OpenCV (a rembg dependency) links against.
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel \
    && pip install torch torchvision --index-url ${TORCH_INDEX}

# SAM 2 after torch and without build isolation, so its build reuses the torch above instead of downloading another.
RUN SAM2_BUILD_CUDA=0 pip install --no-build-isolation sam2

COPY pyproject.toml ./
COPY worker ./worker
RUN pip install ".[assets]"

# The weights are part of the image, so the first job is not a multi-minute download.
RUN python -m worker.download_models

CMD ["python", "-m", "worker.main"]
