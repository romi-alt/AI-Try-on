# FastAPI service. Copy to .env for running natively (uvicorn on the host).
# When run via docker-compose these are injected by infra/docker-compose.yml.

DATABASE_URL=postgresql+psycopg://tryon:tryon_dev_password@localhost:5432/tryon
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, Cloudflare R2 in prod — both S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_PRESIGN_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tryon-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_password
S3_PUBLIC_BASE_URL=http://localhost:9000/tryon-media
PRESIGN_EXPIRES_SECONDS=600
# Largest garment image kept in the bucket; bigger uploads are deleted after the fact
GARMENT_MAX_BYTES=10485760

# Comma-separated browser origins allowed to call the API (the kiosk, plus the admin app)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Dev-only shared secrets (header: X-Admin-Key). The admin app sends the admin key from its server, never the browser.
ADMIN_API_KEY=dev-admin-key
# The staff page (/staff on the kiosk app) signs in with this (header: X-Staff-Key). The admin key also works.
STAFF_API_KEY=dev-staff-key

# --- "Request Outfit" notifications: console (dev) | whatsapp (WhatsApp Cloud API) ---
NOTIFIER=console
# Only used when NOTIFIER=whatsapp. Never commit real values.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated recipients, digits only, with country code
WHATSAPP_TO=
# A message outside WhatsApp's 24 hour window must be an approved template; set its name to send that instead of text
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- mobile page (/m/CODE) and payment ---
SHARE_LINK_TTL_SECONDS=86400
# stub approves every payment without contacting anyone; add a real provider in app/services/payments.py
PAYMENT_PROVIDER=stub
# Set to failed to see the declined-payment path
STUB_PAYMENT_OUTCOME=paid

# Queue for the heavy asset jobs (background removal, embeddings); must match the worker's
ASSETS_QUEUE_NAME=assets

# RQ queue the worker consumes (must match the worker's TRYON_QUEUE_NAME)
TRYON_QUEUE_NAME=tryon
TRYON_JOB_TIMEOUT_SECONDS=300
# Latest state of each job (Redis hash job:{id}) is kept this long after its last update
JOB_STATE_TTL_SECONDS=86400

# --- WebSocket /ws ---
WS_HEARTBEAT_SECONDS=25

# --- POST /capture ---
CAPTURE_MAX_BYTES=5242880
CAPTURE_MIN_HEIGHT=768
CAPTURE_MAX_PIXELS=40000000
# Captures are personal photos: the background sweeper deletes them after this many seconds.
CAPTURE_TTL_SECONDS=3600
CAPTURE_CLEANUP_ENABLED=true
CAPTURE_CLEANUP_INTERVAL_SECONDS=300

# Finished looks show the shopper's face too: deleted on the same schedule as captures (the privacy notice says one hour)
RESULT_TTL_SECONDS=3600

# --- rate limiting (per session and per address; see app/core/ratelimit.py) ---
RATE_LIMIT_ENABLED=true
# Multiply every limit, e.g. 2.0 when several mirrors share one shop address
RATE_LIMIT_SCALE=1.0
# If Redis is down: true lets requests through, false refuses them
RATE_LIMIT_FAIL_OPEN=true
# Largest request body of any endpoint except /capture and /products/import
DEFAULT_BODY_LIMIT_BYTES=262144

# Turn the interactive /docs and /openapi.json off on a public server
API_DOCS_ENABLED=true

# --- error tracking and anonymous analytics (each off while empty) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Server-side events: session_start, capture, tryon_done, add_to_cart, request_outfit (see DEPLOY.md)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

LOG_LEVEL=INFO
