# FastAPI service. Copy to .env for running natively (uvicorn on the host).
# When run via docker-compose these are injected by infra/docker-compose.yml.

DATABASE_URL=postgresql+psycopg://tryon:tryon_dev_password@localhost:5432/tryon
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, Cloudflare R2 in prod — both S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_PRESIGN_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tryon-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_password
S3_PUBLIC_BASE_URL=http://localhost:9000/tryon-media
PRESIGN_EXPIRES_SECONDS=600
# Largest garment image kept in the bucket; bigger uploads are deleted after the fact
GARMENT_MAX_BYTES=10485760

# Comma-separated browser origins allowed to call the API (the kiosk, plus the admin app)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Dev-only shared secret for admin endpoints (header: X-Admin-Key)
ADMIN_API_KEY=dev-admin-key

# RQ queue the worker consumes (must match the worker's TRYON_QUEUE_NAME)
TRYON_QUEUE_NAME=tryon
TRYON_JOB_TIMEOUT_SECONDS=300
# Latest state of each job (Redis hash job:{id}) is kept this long after its last update
JOB_STATE_TTL_SECONDS=86400

# --- WebSocket /ws ---
WS_HEARTBEAT_SECONDS=25

# --- POST /capture ---
CAPTURE_MAX_BYTES=5242880
CAPTURE_MIN_HEIGHT=768
CAPTURE_MAX_PIXELS=40000000
# Captures are personal photos: the background sweeper deletes them after this many seconds.
CAPTURE_TTL_SECONDS=3600
CAPTURE_CLEANUP_ENABLED=true
CAPTURE_CLEANUP_INTERVAL_SECONDS=300

LOG_LEVEL=INFO
